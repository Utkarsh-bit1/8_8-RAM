//Verilog RTL Code


`timescale 1ns / 1ps 

module RAM_8_8( 
    input clk,rst,w_enb,
    input [2:0] write_address,
    input [2:0] read_address,
    input [7:0] din,
    output reg [7:0] dout
   
    );
    
    reg [7:0] memory [7:0];
    integer i ;
    
    always @ (posedge clk or posedge rst)
    begin
    
        if (rst==1'b1 && w_enb==1'b1) begin
        for (i=0 ; i<=7 ; i=i+1)
        memory[i] <= 0;
        end
        
        else if (w_enb) begin
        memory[write_address] <= din;
        end
        
     end
     
     
     
 always @ (posedge clk or posedge rst) begin 
 
 
     if (w_enb==1'b0)
     dout <=memory[read_address];
     
     else if(rst==1'b1)
     dout<=8'b0;
     
     
     else 
     dout<=0;
 end
endmodule  
        
    
    
    
    
    
    
    
    
    
    
    

